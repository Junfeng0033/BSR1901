@echo off
setlocal EnableDelayedExpansion
rem Generated by scgui Designer — build with MinGW gcc (CMake not required).
rem Edit SCGUI_SDL2_DIR below, or: set SCGUI_SDL2_DIR=C:\path\to\sdl2
rem Widget features come from sc_config.h (project config), not -D here.

set ROOT=%~dp0
if "%ROOT:~-1%"=="\" set ROOT=%ROOT:~0,-1%

rem ---- SDL2 SDK root：相对工程目录 sdl2/（设计器导出时已拷入） ----
if not defined SCGUI_SDL2_DIR (
  set SCGUI_SDL2_DIR=%ROOT%\sdl2
)

if not defined GCC (
  if exist "C:\MinGW\bin\gcc.exe" (set GCC=C:\MinGW\bin\gcc.exe) else (set GCC=gcc)
)

if not exist "%SCGUI_SDL2_DIR%\include\SDL2\SDL.h" (
  echo SDL2 headers not found: %SCGUI_SDL2_DIR%\include\SDL2\SDL.h
  echo Set SCGUI_SDL2_DIR to your SDL2 SDK root and retry.
  exit /b 1
)

if not exist "%ROOT%\build" mkdir "%ROOT%\build"

set SOURCES=main.c sc_sdl2.c
for %%F in ("%ROOT%\src\*.c") do set SOURCES=!SOURCES! "%%~F"
for %%F in ("%ROOT%\src\widget\*.c") do set SOURCES=!SOURCES! "%%~F"
for %%F in ("%ROOT%\src\third_party\qrcode\*.c") do set SOURCES=!SOURCES! "%%~F"
for %%F in ("%ROOT%\generated\*.c") do set SOURCES=!SOURCES! "%%~F"
for %%F in ("%ROOT%\generated\images\*.c") do set SOURCES=!SOURCES! "%%~F"
for %%F in ("%ROOT%\generated\fonts\*.c") do set SOURCES=!SOURCES! "%%~F"

echo Building scgui.exe with %GCC% ...
"%GCC%" ^
  -std=c99 -O2 -Wall -Wno-unused-parameter ^
  -ffunction-sections -fdata-sections ^
  -I"%ROOT%" ^
  -I"%ROOT%\src" ^
  -I"%ROOT%\generated" ^
  -I"%ROOT%\generated\images" ^
  -I"%ROOT%\generated\fonts" ^
  -I"%SCGUI_SDL2_DIR%\include" ^
  -L"%SCGUI_SDL2_DIR%\lib" ^
  %SOURCES% ^
  -Wl,--gc-sections ^
  -lmingw32 -lSDL2main -lSDL2 ^
  -o "%ROOT%\build\scgui.exe"
if errorlevel 1 exit /b 1

if exist "%SCGUI_SDL2_DIR%\bin\SDL2.dll" (
  copy /Y "%SCGUI_SDL2_DIR%\bin\SDL2.dll" "%ROOT%\build\SDL2.dll" >nul
)
rem 复制外部 Flash bin 资源到 build 目录（sc_spiflash_mount_file 从 exe 所在目录查找）
if exist "%ROOT%\generated\images\*.bin" copy /Y "%ROOT%\generated\images\*.bin" "%ROOT%\build\" >nul
if exist "%ROOT%\generated\fonts\*.bin" copy /Y "%ROOT%\generated\fonts\*.bin" "%ROOT%\build\" >nul
if exist "%ROOT%\generated\merged.bin" copy /Y "%ROOT%\generated\merged.bin" "%ROOT%\build\" >nul
echo Build complete: build\scgui.exe
endlocal
